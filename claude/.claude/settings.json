{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "CronCreate",
      "EnterWorktree",
      "ScheduleWakeup",
      "ExitWorktree",
      "EnterWorktree",
      "CronDelete",
      "CronList",
      "AskUserQuestion"
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": []
      }
    ],
    "SessionStart": [
      {
        "hooks": []
      }
    ]
  },
  "disableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/bin/statusline.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "context-mode@context-mode": false
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "rpi": {
      "source": {
        "source": "github",
        "repo": "A-NGJ/rpi"
      }
    },
    "llm-wiki": {
      "source": {
        "source": "github",
        "repo": "A-NGJ/obsidian-llm-wiki-skill"
      }
    }
  },
  "effortLevel": "medium"
}
