{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__plugin_context-mode_context-mode__*"
    ],
    "deny": [
        "EnterPlanMode",
        "ExitPlanMode",
        "DesignSync",
        "NotebookEdit",
        "CronCreate",
        "EnterWorktree",
        "ScheduleWakeup",
        "ExitWorktree",
        "EnterWorktree",
        "CronDelete",
        "CronList"
    ]
  },
  "model": "fable",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check_code_quality_go.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/run_check_sh.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/awnj/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/bin/statusline.sh"
  },
  "enabledPlugins": {
    "context-mode@context-mode": false
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "rpi": {
      "source": {
        "source": "github",
        "repo": "A-NGJ/rpi"
      }
    },
    "llm-wiki": {
      "source": {
        "source": "github",
        "repo": "A-NGJ/obsidian-llm-wiki-skill"
      }
    }
  },
  "effortLevel": "high"
}
