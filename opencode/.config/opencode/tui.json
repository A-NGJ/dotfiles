{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "catppuccin-macchiato-visible",
  "mouse": false,
  "keybinds": {
    "messages_line_up": "alt+k",
    "messages_line_down": "alt+j",
    "messages_half_page_up": "alt+u",
    "messages_half_page_down": "alt+d",
    "messages_first": "alt+g",
    "messages_last": "alt+shift+g"
  }
}
